<%- include('./partials/header') %>

<div class="w-full min-h-screen pt-20 flex flex-col md:flex-row px-8 md:px-20 bg-zinc-50 items-center justify-center relative">
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-red-500 text-white shadow-lg z-50 transition-all duration-300">
            <span class="inline-block text-sm font-medium">
                <%= error %>
            </span>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-emerald-500 text-white shadow-lg z-50 transition-all duration-300">
            <span class="inline-block text-sm font-medium">
                <%= success %>
            </span>
        </div>
    <% } %>

    <div class="w-full md:w-1/2 flex items-center justify-center p-6 md:p-12">
        <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-sm border border-zinc-100">
            <h3 class="text-3xl font-bold tracking-tight mb-1 text-zinc-900">Welcome to <span class="text-indigo-600 font-extrabold">Shopping-Bag</span></h3>
            <h4 class="text-lg text-zinc-500 mb-6 font-medium">Create your account</h4>
            <form autocomplete="off" action="/users/register" method="post" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Full Name</label>
                    <input
                        class="bg-zinc-50 block w-full px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm"
                        type="text" placeholder="Ayush Jayant" name="fullname" required>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Email</label>
                    <input
                        class="bg-zinc-50 block w-full px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm"
                        type="email" placeholder="ayush@example.com" name="email" required>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Password</label>
                    <input
                        class="bg-zinc-50 block w-full px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm"
                        type="password" placeholder="••••••••" name="password" required>
                </div>
                <button class="w-full py-3 mt-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-md transition-colors text-sm" type="submit">
                    Create My Account
                </button>
            </form>
        </div>
    </div>

    <div class="w-full md:w-1/2 flex items-center justify-center p-6 md:p-12">
        <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-sm border border-zinc-100">
            <h4 class="text-2xl font-bold tracking-tight text-zinc-900 mb-1">Login to Account</h4>
            <p class="text-sm text-zinc-500 mb-6">Welcome back! Please enter your details.</p>
            <form autocomplete="off" action="/users/login" method="post" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Email</label>
                    <input
                        class="bg-zinc-50 block w-full px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm"
                        type="email" placeholder="ayush@example.com" name="email" required>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Password</label>
                    <input
                        class="bg-zinc-50 block w-full px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm"
                        type="password" placeholder="••••••••" name="password" required>
                </div>
                <button class="w-full py-3 mt-4 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-xl shadow-md transition-colors text-sm" type="submit">
                    Login
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>