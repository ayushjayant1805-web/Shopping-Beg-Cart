<%- include('./partials/header') %>

<div class="w-full min-h-screen pt-24 pb-12 px-6 md:px-16 flex flex-col md:flex-row gap-10 bg-zinc-50">
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-red-500 text-white shadow-lg z-50">
            <span class="inline-block text-sm font-medium"><%= error %></span>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-emerald-500 text-white shadow-lg z-50">
            <span class="inline-block text-sm font-medium"><%= success %></span>
        </div>
    <% } %>

    <!-- Admin Sidebar Nav -->
    <div class="w-full md:w-64 shrink-0 flex flex-col justify-between h-fit bg-white p-6 rounded-2xl border border-zinc-200 shadow-sm">
        <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400 mb-4">Admin Dashboard</h3>
            <div class="flex flex-col space-y-2 text-sm font-medium">
                <a href="/owners/admin" class="flex items-center gap-2 p-2 rounded-xl bg-indigo-50 text-indigo-600 font-semibold">
                    <i class="ri-dashboard-line"></i> All Products
                </a>
                <a href="/products/create" class="flex items-center gap-2 p-2 rounded-xl text-zinc-600 hover:bg-zinc-50 hover:text-indigo-600 transition-colors">
                    <i class="ri-add-circle-line"></i> Create New Product
                </a>
            </div>
        </div>

        <div class="mt-8 pt-4 border-t border-zinc-100">
            <form action="/owners/logout" method="post">
                <button type="submit" class="w-full text-left flex items-center gap-2 p-2 text-sm font-medium text-red-500 hover:bg-red-50 rounded-xl transition-colors">
                    <i class="ri-logout-box-r-line"></i> Logout Admin
                </button>
            </form>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h2 class="text-2xl font-bold text-zinc-900">Manage Products</h2>
                <p class="text-xs text-zinc-400 mt-1">Total items in inventory: <%= products.length %></p>
            </div>
            <a href="/products/create" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-xl shadow transition-colors flex items-center gap-2">
                <i class="ri-add-line"></i> Add Product
            </a>
        </div>

        <% if (products.length === 0) { %>
            <div class="w-full py-20 text-center bg-white rounded-2xl border border-zinc-200">
                <i class="ri-inbox-line text-5xl text-zinc-300 mb-3 block"></i>
                <h3 class="text-lg font-semibold text-zinc-700">No products found</h3>
                <p class="text-sm text-zinc-400 mt-1 mb-4">You haven't created any products yet.</p>
                <a href="/products/create" class="px-4 py-2 bg-indigo-600 text-white text-sm rounded-xl font-medium">Create First Product</a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <% products.forEach(function(product){ %>
                    <div class="rounded-2xl overflow-hidden bg-white border border-zinc-200 shadow-sm flex flex-col justify-between">
                        <div class="w-full h-48 flex items-center justify-center p-4 relative" style="background-color: <%= product.bgcolor || '#f4f4f5' %>;">
                            <% if (product.image && product.image.length) { %>
                                <img class="h-36 object-contain" 
                                     src="data:<%= product.contentType || 'image/jpeg' %>;base64,<%= product.image.toString('base64') %>"
                                     alt="<%= product.name %>">
                            <% } else { %>
                                <i class="ri-image-line text-4xl text-zinc-400"></i>
                            <% } %>
                        </div>
                        <div class="p-4 flex items-center justify-between" style="background-color: <%= product.panelcolor || '#ffffff' %>; color: <%= product.textcolor || '#18181b' %>;">
                            <div>
                                <h3 class="font-semibold text-base line-clamp-1"><%= product.name %></h3>
                                <h4 class="font-bold text-sm mt-0.5">₹ <%= product.price %></h4>
                            </div>
                            <a href="/products/delete/<%= product._id %>" 
                               onclick="return confirm('Are you sure you want to delete this product?')"
                               class="w-9 h-9 flex items-center justify-center rounded-full bg-red-100 text-red-600 hover:bg-red-200 transition-colors shrink-0">
                                <i class="ri-delete-bin-line text-lg"></i>
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>

<%- include('./partials/footer') %>