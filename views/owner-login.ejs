<%- include('./partials/header') %>

<div class="w-full min-h-screen pt-20 flex items-center justify-center px-6 bg-zinc-50 relative">
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-red-500 text-white shadow-lg z-50">
            <span class="inline-block text-sm font-medium"><%= error %></span>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-emerald-500 text-white shadow-lg z-50">
            <span class="inline-block text-sm font-medium"><%= success %></span>
        </div>
    <% } %>

    <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-sm border border-zinc-100">
        <div class="text-center mb-6">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-3">
                <i class="ri-shield-user-line text-2xl"></i>
            </div>
            <h4 class="text-2xl font-bold text-zinc-900">Admin Portal Login</h4>
            <p class="text-sm text-zinc-500 mt-1">Access the product management dashboard</p>
        </div>

        <form action="/owners/login" method="post" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Owner Email</label>
                <input class="bg-zinc-50 block w-full px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm"
                    type="email" placeholder="admin@shoppingbag.com" name="email" required>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Password</label>
                <input class="bg-zinc-50 block w-full px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm"
                    type="password" placeholder="••••••••" name="password" required>
            </div>
            <button class="w-full py-3 mt-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-md transition-colors text-sm" type="submit">
                Login as Owner
            </button>
        </form>
    </div>
</div>

<%- include('./partials/footer') %>