<%- include('./partials/header') %>

<div class="w-full min-h-screen pt-24 pb-12 px-6 md:px-16 flex flex-col md:flex-row gap-10 bg-zinc-50 relative">
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-red-500 text-white shadow-lg z-50">
            <span class="inline-block text-sm font-medium"><%= error %></span>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 p-3 px-6 rounded-lg bg-emerald-500 text-white shadow-lg z-50">
            <span class="inline-block text-sm font-medium"><%= success %></span>
        </div>
    <% } %>

    <!-- Admin Sidebar Nav -->
    <div class="w-full md:w-64 shrink-0 flex flex-col justify-between h-fit bg-white p-6 rounded-2xl border border-zinc-200 shadow-sm">
        <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400 mb-4">Admin Dashboard</h3>
            <div class="flex flex-col space-y-2 text-sm font-medium">
                <a href="/owners/admin" class="flex items-center gap-2 p-2 rounded-xl text-zinc-600 hover:bg-zinc-50 hover:text-indigo-600 transition-colors">
                    <i class="ri-dashboard-line"></i> All Products
                </a>
                <a href="/products/create" class="flex items-center gap-2 p-2 rounded-xl bg-indigo-50 text-indigo-600 font-semibold">
                    <i class="ri-add-circle-line"></i> Create New Product
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 bg-white p-8 rounded-2xl border border-zinc-200 shadow-sm">
        <h2 class="text-2xl font-bold text-zinc-900 mb-6">Create New Product</h2>
        
        <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data" class="space-y-6">
            <div>
                <h3 class="text-base font-semibold text-zinc-800 mb-4 pb-2 border-b border-zinc-100">Product Information</h3>
                
                <div class="mb-4">
                    <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Product Image</label>
                    <input name="image" type="file" accept="image/*" class="block w-full text-sm text-zinc-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-600 hover:file:bg-indigo-100">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Product Name</label>
                        <input name="name" type="text" placeholder="e.g. Leather Clinge Bag" required
                            class="bg-zinc-50 border border-zinc-200 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Price (₹)</label>
                        <input name="price" type="number" step="0.01" placeholder="1200" required
                            class="bg-zinc-50 border border-zinc-200 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Discount (%)</label>
                        <input name="discount" type="number" placeholder="10"
                            class="bg-zinc-50 border border-zinc-200 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white">
                    </div>
                </div>
            </div>

            <div>
                <h3 class="text-base font-semibold text-zinc-800 mb-4 pb-2 border-b border-zinc-100">Panel Custom Styling</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Background Color</label>
                        <input name="bgcolor" type="text" placeholder="#f4f4f5"
                            class="bg-zinc-50 border border-zinc-200 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Panel Color</label>
                        <input name="panelcolor" type="text" placeholder="#ffffff"
                            class="bg-zinc-50 border border-zinc-200 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-zinc-500 mb-1">Text Color</label>
                        <input name="textcolor" type="text" placeholder="#18181b"
                            class="bg-zinc-50 border border-zinc-200 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white">
                    </div>
                </div>
            </div>

            <button type="submit" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-md transition-colors text-sm">
                Create New Product
            </button>
        </form>
    </div>
</div>

<%- include('./partials/footer') %>